
### **pyproject.toml**
```toml
[build-system]
requires = ["setuptools>=61.0", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "solar-chromosphere-velocity"
version = "1.0.0"
description = "Solar chromosphere velocity data processing package for CHASE mission"
readme = "README.md"
authors = [
    {name = "Solar Physics Team", email = "solar@example.com"},
]
license = {text = "MIT"}
classifiers = [
    "Development Status :: 4 - Beta",
    "Intended Audience :: Science/Research",
    "Topic :: Scientific/Engineering :: Astronomy",
    "License :: OSI Approved :: MIT License",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3.8",
    "Programming Language :: Python :: 3.9",
    "Programming Language :: Python :: 3.10",
    "Programming Language :: Python :: 3.11",
]
keywords = ["solar physics", "chromosphere", "velocity", "CHASE", "astronomy"]
dependencies = [
    "numpy>=1.21.0",
    "scipy>=1.7.0",
    "astropy>=5.0",
    "sunpy>=3.0",
    "matplotlib>=3.5.0",
    "scikit-image>=0.19.0",
    "tqdm>=4.64.0",
    "fitsio>=1.1.0",
    "numba>=0.56.0",
]
requires-python = ">=3.8"

[project.urls]
Homepage = "https://github.com/yourusername/solar-chromosphere-velocity"
Documentation = "https://docs.solar-chromosphere-velocity.org"
Source = "https://github.com/yourusername/solar-chromosphere-velocity"
Issues = "https://github.com/yourusername/solar-chromosphere-velocity/issues"

[project.optional-dependencies]
dev = [
    "pytest>=7.0",
    "pytest-cov>=4.0",
    "black>=22.0",
    "flake8>=5.0",
    "mypy>=0.991",
]
docs = [
    "sphinx>=5.0",
    "sphinx-rtd-theme>=1.0",
    "nbsphinx>=0.8.0",
]

[project.scripts]
process-chase = "solar_chromosphere_velocity.cli:main"